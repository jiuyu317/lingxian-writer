            p_user_id: user.id,
            p_credits_to_add: plan.aiCredits,
            p_subscription_tier: plan.id,
            p_duration_months: plan.durationMonths
          });
        
        if (error) throw error;
        
        // 记录支付
        const { error: paymentError } = await supabase
