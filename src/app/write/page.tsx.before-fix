'use client'

import { useState, useEffect, useCallback, useRef } from 'react'
import { useRouter, useSearchParams } from 'next/navigation'
import Link from 'next/link'
import { generateAIContent } from '@/app/actions/writing'
import { 
  getUserSettings, 
  saveUserSettings, 
  saveWritingHistory,
  autoSaveDraft,
  saveCurrentAIResult 
} from '@/app/actions/db-actions'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { 
  ArrowLeft, Sparkles, Brain, Copy, Save, RefreshCw, Check, Zap, 
  AlertCircle, Lightbulb, Plus, X, Bookmark, Download, History, Settings 
} from 'lucide-react'

import { useLoadingOptimization, LoadingStatus, LoadingButton } from '@/components/loading/LoadingOptimization'

export default function WritePageEnhanced() {
  const router = useRouter()
  const searchParams = useSearchParams()
  const [loading, setLoading] = useState(false)

  // 使用新的加载状态Hook
  const { 
    loadingState, 
    startLoading, 
    updateStatus, 
    updateProgress, 
    completeLoading, 
    errorLoading 
  } = useLoadingOptimization()
  const [result, setResult] = useState('')
  const [error, setError] = useState('')
  const [success, setSuccess] = useState('')
  const [copied, setCopied] = useState(false)
  const [wordCount, setWordCount] = useState(0)
  const [isInspirationMode, setIsInspirationMode] = useState(false)
  const [isPlusMode, setIsPlusMode] = useState(false)
  const [element1, setElement1] = useState('')
  const [element2, setElement2] = useState('')
  
  // 表单状态 - 必须先定义，因为其他useEffect会引用它
  const [formData, setFormData] = useState({
    topic: '',
    style: 'balanced',
    emotionIntensity: 50,
    creativityLevel: 70,
    length: 'medium',
    additionalInstructions: ''
  })
  
  // 用户设置状态
  const [userSettings, setUserSettings] = useState({
    writingStyle: 'balanced',
    emotionIntensity: 50,
    creativityLevel: 70,
    defaultLength: 'medium',
    autoSave: true,
    autoSaveInterval: 30
  })
  
  // 自动保存相关
  const [lastSaveTime, setLastSaveTime] = useState<Date | null>(null)
  const [autoSaveEnabled, setAutoSaveEnabled] = useState(true)
  const autoSaveTimerRef = useRef<NodeJS.Timeout | null>(null)
  const lastContentRef = useRef('')
  
  // 检查URL参数
  useEffect(() => {
    const mode = searchParams.get('mode')
    setIsInspirationMode(mode === 'inspiration')
  }, [searchParams])
  
  // 加载用户设置
  useEffect(() => {
    loadUserSettings()
  }, [])
  
  // 设置自动保存
  useEffect(() => {
    if (userSettings.autoSave && userSettings.autoSaveInterval > 0) {
      setupAutoSave()
    } else {
      cleanupAutoSave()
    }
    
    return () => {
      {/* 加载状态模态框 */}
      <LoadingStatus loadingState={loadingState} />
      
      cleanupAutoSave()
    }
  }, [userSettings.autoSave, userSettings.autoSaveInterval, formData, result])
  
  // 根据模式更新表单默认值
  useEffect(() => {
    // 只在模式变化时更新，避免循环
    if (isInspirationMode) {
      setFormData(prev => {
        // 如果已经是创意模式，不重复设置
        if (prev.style === 'creative' && prev.emotionIntensity === 80 && prev.creativityLevel === 100) {
          return prev
        }
        return {
          topic: prev.topic,
          style: 'creative',
          emotionIntensity: 80,
          creativityLevel: 100,
          length: 'short',
          additionalInstructions: '请生成让人眼前一亮的创意写作点子，字数控制在200-400字左右，确保创意完整性'
        }
      })
    } else {
      // 只在用户设置变化时更新普通模式
      setFormData(prev => ({
        ...prev,
        style: userSettings.writingStyle,
        emotionIntensity: userSettings.emotionIntensity,
        creativityLevel: userSettings.creativityLevel,
        length: userSettings.defaultLength
      }))
    }
  }, [isInspirationMode, userSettings.writingStyle, userSettings.emotionIntensity, userSettings.creativityLevel, userSettings.defaultLength])
  
  // 加载用户设置
  const loadUserSettings = async () => {
    try {
      const response = await getUserSettings()
      if (response.success && response.data) {
        setUserSettings({
          writingStyle: response.data.writingStyle,
          emotionIntensity: response.data.emotionIntensity,
          creativityLevel: response.data.creativityLevel,
          defaultLength: response.data.defaultLength,
          autoSave: response.data.autoSave,
          autoSaveInterval: response.data.autoSaveInterval
        })
        
        // 更新表单默认值
        if (!isInspirationMode) {
          setFormData(prev => ({
            ...prev,
            style: response.data!.writingStyle,
            emotionIntensity: response.data!.emotionIntensity,
            creativityLevel: response.data!.creativityLevel,
            length: response.data!.defaultLength
          }))
        }
      }
    } catch (err) {
      console.error('加载用户设置失败:', err)
    }
  }
  
  // 保存用户设置
  const saveSettings = async () => {
    try {
      const response = await saveUserSettings({
        writingStyle: formData.style,
        emotionIntensity: formData.emotionIntensity,
        creativityLevel: formData.creativityLevel,
        defaultLength: formData.length,
        autoSave: userSettings.autoSave,
        autoSaveInterval: userSettings.autoSaveInterval
      })
      
      if (response.success) {
        setSuccess('设置已保存')
        setTimeout(() => setSuccess(''), 3000)
      } else {
        setError(response.error || '保存设置失败')
      }
    } catch (err) {
      setError('保存设置失败')
    }
  }
  
  // 设置自动保存
  const setupAutoSave = () => {
    cleanupAutoSave()
    
    autoSaveTimerRef.current = setInterval(() => {
      performAutoSave()
    }, userSettings.autoSaveInterval * 1000)
  }
  
  const cleanupAutoSave = () => {
    if (autoSaveTimerRef.current) {
      clearInterval(autoSaveTimerRef.current)
      autoSaveTimerRef.current = null
    }
  }
  
  // 执行自动保存
  const performAutoSave = useCallback(async () => {
    if (!userSettings.autoSave) return
    
    const currentContent = result || formData.topic
    if (!currentContent || currentContent === lastContentRef.current) {
      return // 没有内容或内容未变化
    }
    
    lastContentRef.current = currentContent
    
    try {
      const draftData = {
        content: currentContent,
        topic: formData.topic,
        style: formData.style,
        emotionIntensity: formData.emotionIntensity,
        creativityLevel: formData.creativityLevel,
        length: formData.length,
        additionalInstructions: formData.additionalInstructions,
        mode: isInspirationMode ? 'inspiration' : 'writing' as const
      }
      
      const response = await autoSaveDraft(draftData)
      if (response.success) {
        setLastSaveTime(new Date())
        console.log('自动保存成功:', response.data?.id)
      }
    } catch (err) {
      console.error('自动保存失败:', err)
    }
  }, [userSettings.autoSave, result, formData, isInspirationMode])
  
  // 手动保存草稿
  const handleManualSave = async () => {
    const currentContent = result || formData.topic
    if (!currentContent) {
      setError('没有内容可保存')
      return
    }
    
    try {
      const draftData = {
        content: currentContent,
        topic: formData.topic,
        style: formData.style,
        emotionIntensity: formData.emotionIntensity,
        creativityLevel: formData.creativityLevel,
        length: formData.length,
        additionalInstructions: formData.additionalInstructions,
        mode: isInspirationMode ? 'inspiration' : 'writing' as const
      }
      
      const response = await autoSaveDraft({
        ...draftData
      })
      
      if (response.success) {
        setSuccess('草稿已保存')
        setLastSaveTime(new Date())
        setTimeout(() => setSuccess(''), 3000)
      } else {
        setError(response.error || '保存草稿失败')
      }
    } catch (err) {
      setError('保存草稿失败')
    }
  }
  
  // 保存写作历史
  const saveToHistory = async (aiResponse: any) => {
    try {
      const historyData = {
        topic: formData.topic || (isPlusMode ? `${element1} + ${element2}` : '未命名主题'),
        style: formData.style,
        emotionIntensity: formData.emotionIntensity,
        creativityLevel: formData.creativityLevel,
        length: formData.length,
        additionalInstructions: formData.additionalInstructions,
        mode: isInspirationMode ? 'inspiration' : 'writing' as const,
        content: aiResponse.content,
        tokensUsed: aiResponse.tokensUsed,
        modelUsed: aiResponse.modelUsed,
        estimatedCost: aiResponse.estimatedCost
      }
      
      const response = await saveWritingHistory(historyData)
      if (response.success) {
        console.log('写作历史已保存:', response.data?.id)
      }
    } catch (err) {
      console.error('保存写作历史失败:', err)
    }
  }
  
  // 收藏当前结果
  const handleSaveToCollection = async () => {
    if (!result) {
      setError('没有内容可收藏')
      return
    }
    
    try {
      const title = formData.topic || (isPlusMode ? `${element1} + ${element2}` : '创意灵感')
      const response = await saveCurrentAIResult({
        title: title.length > 50 ? title.substring(0, 50) + '...' : title,
        content: result,
        sourceData: {
          topic: formData.topic,
          style: formData.style,
          emotionIntensity: formData.emotionIntensity,
          creativityLevel: formData.creativityLevel,
          length: formData.length,
          mode: isInspirationMode ? 'inspiration' : 'writing',
          isPlusMode,
          element1,
          element2
        },
        tags: isInspirationMode ? ['创意灵感'] : ['AI写作'],
        category: isInspirationMode ? '灵感' : '写作'
      })
      
      if (response.success) {
        setSuccess('已收藏到灵感库')
        setTimeout(() => setSuccess(''), 3000)
      } else {
        setError(response.error || '收藏失败')
      }
    } catch (err) {
      setError('收藏失败')
    }
  }
  
  // 处理表单输入变化
  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>) => {
    const { name, value } = e.target
    setFormData(prev => ({ ...prev, [name]: value }))
  }
  
  const handleSliderChange = (name: string, value: number) => {
    setFormData(prev => ({ ...prev, [name]: value }))
  }
  
  // 切换"+"模式
  const togglePlusMode = () => {
    setIsPlusMode(!isPlusMode)
    if (!isPlusMode) {
      setElement1('')
      setElement2('')
    }
  }
  
  // 处理元素输入变化
  const handleElementChange = (element: 'element1' | 'element2', value: string) => {
    if (element === 'element1') {
      setElement1(value)
    } else {
      setElement2(value)
    }
  }
  
  // 提交表单生成内容
    const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    
    // 验证表单
    if (!formData.topic.trim()) {
      setError('请输入写作主题')
      return
    }
    
    // 重置状态
    setError('')
    setSuccess('')
    setResult('')
    setWordCount(0)
    
    // 使用新的加载状态系统
    startLoading(formData.length)
    setLoading(true)
    
    try {
      // 准备表单数据
      const formDataObj = new FormData()
      Object.entries(formData).forEach(([key, value]) => {
        formDataObj.append(key, String(value))
      })
      
      // 添加模式信息
      formDataObj.append('mode', isInspirationMode ? 'inspiration' : 'writing')
      formDataObj.append('element1', element1)
      formDataObj.append('element2', element2)
      
      // 更新状态：开始生成
      updateStatus('generating', 'AI正在深度思考创意...')
      
      // 调用AI生成
      const response = await generateAIContent(formDataObj)
      
      // 更新状态：生成完成，开始保存
      updateStatus('saving', '保存生成结果...')
      updateProgress(90)
      
      if (response.success) {
        setResult(response.content)
        setSuccess('内容生成成功！')
        
        // 计算字数
        const words = response.content.trim().split(/\s+/).length
        setWordCount(words)
        
        // 保存到历史记录
        if (response.data) {
          await saveToHistory(response.data)
        }
        
        // 如果是普通写作模式，保存当前设置
        if (!isInspirationMode) {
          await saveSettings()
        }
        
        // 完成加载
        completeLoading()
        setSuccess('🎉 生成完成！内容已保存')
        
      } else {
        errorLoading(response.error || '生成内容失败')
        setError(response.error || '生成内容失败')
      }
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : '发生未知错误'
      errorLoading(errorMessage)
      setError(errorMessage)
    } finally {
      setLoading(false)
    }
  }
      } else if (isInspirationMode && !isPlusMode) {
        if (!formData.topic.trim()) {
          setError('请输入灵感主题')
          setLoading(false)
          return
        }
      } else {
        if (!formData.topic.trim()) {
          setError('请输入写作主题')
          setLoading(false)
          return
        }
      }
      
      const formDataObj = new FormData()
      
      // 如果是"+"模式，使用组合主题
      if (isInspirationMode && isPlusMode && element1 && element2) {
        const combinedTopic = `${element1} + ${element2}`
        formDataObj.append('topic', combinedTopic)
        formDataObj.append('style', 'creative')
        formDataObj.append('emotionIntensity', '80')
        formDataObj.append('creativityLevel', '100')
        formDataObj.append('length', 'short')
        formDataObj.append('additionalInstructions', `请将"${element1}"和"${element2}"这两个看似无关的元素创意地结合起来，生成让人眼前一亮的灵感点子，字数控制在200-400字左右，确保创意完整性`)
      } else {
        Object.entries(formData).forEach(([key, value]) => {
          formDataObj.append(key, value.toString())
        })
      }
      
      if (isInspirationMode) {
        formDataObj.append('mode', 'inspiration')
      }
      
      console.log('提交表单数据:', {
        isInspirationMode,
        isPlusMode,
        element1,
        element2,
        formData: Object.fromEntries(formDataObj.entries())
      })
      
      const response = await generateAIContent(formDataObj)
      
      if (response.success) {
        setResult(response.content)
        setSuccess('内容生成成功！')
        
        // 计算字数
        const words = response.content.trim().split(/\s+/).length
        setWordCount(words)
        
        // 保存到历史记录
        if (response.data) {
          await saveToHistory(response.data)
        }
        
        // 如果是普通写作模式，保存当前设置
        if (!isInspirationMode) {
          await saveSettings()
        }
      } else {
        setError(response.error || '生成内容失败')
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : '发生未知错误')
    } finally {
      setLoading(false)
    }
  }
  
  // 复制结果到剪贴板
  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(result)
      setCopied(true)
      setTimeout(() => setCopied(false), 2000)
      setSuccess('已复制到剪贴板')
      setTimeout(() => setSuccess(''), 2000)
    } catch (err) {
      setError('复制失败')
    }
  }
  
  // 清空表单
  const handleClear = () => {
    setFormData({
      topic: '',
      style: isInspirationMode ? 'creative' : userSettings.writingStyle,
      emotionIntensity: isInspirationMode ? 80 : userSettings.emotionIntensity,
      creativityLevel: isInspirationMode ? 100 : userSettings.creativityLevel,
      length: isInspirationMode ? 'short' : userSettings.defaultLength,
      additionalInstructions: isInspirationMode ? '请生成让人眼前一亮的创意写作点子，字数控制在200-400字左右，确保创意完整性' : ''
    })
    setResult('')
    setError('')
    setSuccess('')
    setElement1('')
    setElement2('')
    lastContentRef.current = ''
  }
  
  // 重新生成
  const handleRegenerate = () => {
    setResult('')
    setSuccess('')
    handleSubmit(new Event('submit') as any)
  }
  
  // 导出为Markdown
  const handleExportMarkdown = () => {
    if (!result) {
      setError('没有内容可导出')
      return
    }
    
    const title = formData.topic || (isPlusMode ? `${element1} + ${element2}` : 'AI生成内容')
    const markdown = `# ${title}\n\n${result}\n\n---\n\n*生成时间: ${new Date().toLocaleString('zh-CN')}*\n*字数: ${wordCount}字*`
    
    const blob = new Blob([markdown], { type: 'text/markdown;charset=utf-8' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `${title.replace(/[^\w\u4e00-\u9fa5]/g, '_')}.md`
    document.body.appendChild(a)
    a.click()
    document.body.removeChild(a)
    URL.revokeObjectURL(url)
    
    setSuccess('已导出为Markdown文件')
    setTimeout(() => setSuccess(''), 3000)
  }
  
  // 渲染自动保存状态
  const renderAutoSaveStatus = () => {
    if (!userSettings.autoSave) return null
    
    return (
      <div className="text-xs text-gray-500 mt-2">
        {lastSaveTime ? (
          <span>自动保存: {lastSaveTime.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}</span>
        ) : (
          <span>自动保存已启用 ({userSettings.autoSaveInterval}秒间隔)</span>
        )}
      </div>
    )
  }
  
  // 渲染操作按钮组
  const renderActionButtons = () => {
    if (!result) return null
    
    return (
      <div className="flex flex-wrap gap-2 mt-4">
        <Button
          variant="outline"
          size="sm"
          onClick={handleCopy}
          className="flex items-center"
        >
          {copied ? (
            <>
              <Check className="w-4 h-4 mr-2" />
              已复制
            </>
          ) : (
            <>
              <Copy className="w-4 h-4 mr-2" />
              复制
            </>
          )}
        </Button>
        
        <Button
          variant="outline"
          size="sm"
          onClick={handleSaveToCollection}
          className="flex items-center"
        >
          <Bookmark className="w-4 h-4 mr-2" />
          收藏
        </Button>
        
        <Button
          variant="outline"
          size="sm"
          onClick={handleExportMarkdown}
          className="flex items-center"
        >
          <Download className="w-4 h-4 mr-2" />
          导出
        </Button>
        
        <Button
          variant="outline"
          size="sm"
          onClick={handleManualSave}
          className="flex items-center"
        >
          <Save className="w-4 h-4 mr-2" />
          保存草稿
        </Button>
        
        <Button
          variant="outline"
          size="sm"
          onClick={handleRegenerate}
          className="flex items-center"
          disabled={loading}
        >
          <RefreshCw className="w-4 h-4 mr-2" />
          重新生成
        </Button>
      </div>
    )
  }
  
  // 由于代码较长，这里只显示关键部分
  // 完整的UI渲染代码与原始page.tsx类似，但添加了数据持久化功能
  
  return (
    <div className="min-h-screen bg-gray-50">
      {/* 导航栏 */}
      <nav className="bg-white shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between h-16">
            <div className="flex items-center">
              <Link href="/dashboard" className="flex items-center text-gray-700 hover:text-gray-900">
                <ArrowLeft className="w-5 h-5 mr-2" />
                返回仪表板
              </Link>
            </div>
            <div className="flex items-center">
              <div className="flex items-center">
                {isInspirationMode ? (
                  <Lightbulb className="w-8 h-8 text-purple-600" />
                ) : (
                  <Sparkles className="w-8 h-8 text-blue-600" />
                )}
                <span className="ml-2 text-xl font-bold text-gray-900">
                  {isInspirationMode ? '创意灵感生成器' : 'AI写作助手'}
                </span>
              </div>
            </div>
            <div className="flex items-center">
              <div className="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full flex items-center justify-center">
                <span className="text-white text-sm font-medium">U</span>
              </div>
            </div>
          </div>
        </div>
      </nav>
      
      {/* 主内容 */}
      <main className="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <div className="px-4 py-6 sm:px-0">
          {/* 欢迎标题 */}
          <div className="mb-8">
            <div className="flex items-center mb-2">
              {isInspirationMode ? (
                <>
                  <Lightbulb className="w-8 h-8 text-purple-600 mr-3" />
                  <h1 className="text-3xl font-bold text-gray-900">创意灵感生成器</h1>
                </>
              ) : (
                <>
                  <Sparkles className="w-8 h-8 text-blue-600 mr-3" />
                  <h1 className="text-3xl font-bold text-gray-900">AI写作助手</h1>
                </>
              )}
            </div>
            <p className="text-gray-600">
              {isInspirationMode 
                ? '获取写作灵感，激发创作思路，让创意源源不断'
                : '输入你的创意主题，让AI为你生成独特的写作内容'
              }
            </p>
            {renderAutoSaveStatus()}
          </div>
          
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {/* 左侧：写作表单 */}
            <div>
              <Card className="mb-8">
                <CardHeader>
                  <CardTitle className="flex items-center">
                    {isInspirationMode ? (
                      <Lightbulb className="w-5 h-5 mr-2 text-purple-600" />
                    ) : (
                      <Zap className="w-5 h-5 mr-2 text-blue-600" />
                    )}
                    {isInspirationMode ? '创意灵感生成' : '创意灵感生成'}
                  </CardTitle>
                  <CardDescription>
                    {isInspirationMode
                      ? '输入灵感主题，AI将自动生成极致创意的写作点子'
                      : '填写以下信息，AI将为你生成独特的写作内容'
                    }
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <form onSubmit={handleSubmit} className="space-y-6">
                    {/* 创意灵感模式 */}
                    {isInspirationMode ? (
                      <div className="space-y-6">
                        {/* "+"模式切换按钮 */}
                        <div className="flex items-center justify-between">
                          <div className="flex items-center">
                            <Lightbulb className="w-5 h-5 text-purple-600 mr-2" />
                            <span className="text-sm font-medium text-gray-700">
                              {isPlusMode ? '创意组合模式' : '创意灵感模式'}
                            </span>
                          </div>
                          <button
                            type="button"
                            onClick={togglePlusMode}
                            className={`flex items-center px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                              isPlusMode 
                                ? 'bg-purple-100 text-purple-700 hover:bg-purple-200' 
                                : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                            }`}
                          >
                            {isPlusMode ? (
                              <>
                                <X className="w-4 h-4 mr-1" />
                                关闭组合
                              </>
                            ) : (
                              <>
                                <Plus className="w-4 h-4 mr-1" />
                                创意组合
                              </>
                            )}
                          </button>
                        </div>
                        
                        {/* "+"模式：两个元素输入 */}
                        {isPlusMode ? (
                          <div className="space-y-4">
                            <div>
                              <label className="block text-sm font-medium text-gray-700 mb-2">
                                第一个元素 *
                              </label>
                              <input
                                type="text"
                                value={element1}
                                onChange={(e) => handleElementChange('element1', e.target.value)}
                                placeholder="输入第一个元素，如：时间旅行、机器人、魔法..."
                                className="w-full px-4 py-3 border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                                required
                                disabled={loading}
                              />
                            </div>
                            
                            <div className="flex items-center justify-center">
                              <div className="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center">
                                <Plus className="w-4 h-4 text-purple-600" />
                              </div>
                            </div>
                            
                            <div>
                              <label className="block text-sm font-medium text-gray-700 mb-2">
                                第二个元素 *
                              </label>
                              <input
                                type="text"
                                value={element2}
                                onChange={(e) => handleElementChange('element2', e.target.value)}
                                placeholder="输入第二个元素，如：咖啡馆、爱情、未来科技..."
                                className="w-full px-4 py-3 border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                                required
                                disabled={loading}
                              />
                            </div>
                            
                            <div className="p-3 bg-purple-50 rounded-lg">
                              <p className="text-sm text-purple-700">
                                💡 AI将创意地组合"<span className="font-semibold">{element1 || '元素1'}</span>" 
                                和"<span className="font-semibold">{element2 || '元素2'}</span>"， 
                                生成让人眼前一亮的跨界灵感！
                              </p>
                            </div>
                          </div>
                        ) : (
                          /* 普通创意灵感模式：只保留主题输入 */
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-2">
                              灵感主题 *
                            </label>
                            <input
                              type="text"
                              name="topic"
                              value={formData.topic}
                              onChange={handleInputChange}
                              placeholder="输入你想要的灵感主题，如：时间旅行、未来城市、奇幻冒险..."
                              className="w-full px-4 py-3 border border-purple-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500"
                              required
                              disabled={loading}
                            />
                            <p className="mt-2 text-sm text-purple-600">
                              💡 AI将自动使用极致创意参数生成让人眼前一亮的灵感点子
                            </p>
                          </div>
                        )}
                      </div>
                    ) : (
                      /* 普通写作模式：完整表单 */
                      <>
                        {/* 写作主题 */}
                        <div>
                          <label className="block text-sm font-medium text-gray-700 mb-2">
                            写作主题 *
                          </label>
                          <input
                            type="text"
                            name="topic"
                            value={formData.topic}
                            onChange={handleInputChange}
                            placeholder="例如：未来科技、武侠江湖、爱情故事..."
                            className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            required
                            disabled={loading}
                          />
                          <p className="mt-1 text-sm text-gray-500">
                            清晰的主题能让AI生成更相关的内容
                          </p>
                        </div>
                        
                        {/* 写作风格 */}
                        <div>
                          <label className="block text-sm font-medium text-gray-700 mb-2">
                            写作风格 *
                          </label>
                          <select
                            name="style"
                            value={formData.style}
                            onChange={handleInputChange}
                            className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            disabled={loading}
                          >
                            <option value="balanced">平衡风格</option>
                            <option value="creative">创意优先</option>
                            <option value="professional">专业正式</option>
                            <option value="casual">轻松随意</option>
                            <option value="poetic">诗意优美</option>
                            <option value="adventure">热血冒险</option>
                            <option value="romantic">浪漫唯美</option>
                            <option value="mystery">悬疑推理</option>
                            <option value="humorous">幽默诙谐</option>
                          </select>
                        </div>
                        
                        {/* 情绪强度和创意等级 */}
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-2">
                              情绪强度: {formData.emotionIntensity}
                            </label>
                            <input
                              type="range"
                              min="0"
                              max="100"
                              value={formData.emotionIntensity}
                              onChange={(e) => handleSliderChange('emotionIntensity', parseInt(e.target.value))}
                              className="w-full"
                              disabled={loading}
                            />
                            <div className="flex justify-between text-xs text-gray-500 mt-1">
                              <span>平静</span>
                              <span>中等</span>
                              <span>激烈</span>
                            </div>
                          </div>
                          <div>
                            <label className="block text-sm font-medium text-gray-700 mb-2">
                              创意等级: {formData.creativityLevel}
                            </label>
                            <input
                              type="range"
                              min="0"
                              max="100"
                              value={formData.creativityLevel}
                              onChange={(e) => handleSliderChange('creativityLevel', parseInt(e.target.value))}
                              className="w-full"
                              disabled={loading}
                            />
                            <div className="flex justify-between text-xs text-gray-500 mt-1">
                              <span>保守</span>
                              <span>平衡</span>
                              <span>创新</span>
                            </div>
                          </div>
                        </div>
                        
                        {/* 输出长度 */}
                        <div>
                          <label className="block text-sm font-medium text-gray-700 mb-2">
                            输出长度 *
                          </label>
                          <select
                            name="length"
                            value={formData.length}
                            onChange={handleInputChange}
                            className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            disabled={loading}
                          >
                            <option value="short">简短 (100-200字)</option>
                            <option value="medium">中等 (300-500字)</option>
                            <option value="long">长篇 (800-1000字)</option>
                            <option value="detailed">详细 (1500字以上)</option>
                          </select>
                        </div>
                        
                        {/* 额外要求 */}
                        <div>
                          <label className="block text-sm font-medium text-gray-700 mb-2">
                            额外要求（可选）
                          </label>
                          <textarea
                            name="additionalInstructions"
                            value={formData.additionalInstructions}
                            onChange={handleInputChange}
                            placeholder="例如：需要包含对话、使用比喻手法、设置反转结局等..."
                            className="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            rows={3}
                            disabled={loading}
                          />
                        </div>
                      </>
                    )}
                    
                    {/* 错误和成功提示 */}
                    {error && (
                      <div className="p-4 bg-red-50 border border-red-200 rounded-lg">
                        <div className="flex items-center">
                          <AlertCircle className="w-5 h-5 text-red-600 mr-2" />
                          <p className="text-sm text-red-600">{error}</p>
                        </div>
                      </div>
                    )}
                    
                    {success && (
                      <div className="p-4 bg-green-50 border border-green-200 rounded-lg">
                        <div className="flex items-center">
                          <Check className="w-5 h-5 text-green-600 mr-2" />
                          <p className="text-sm text-green-600">{success}</p>
                        </div>
                      </div>
                    )}
                    
                    {/* 表单操作按钮 */}
                    <div className="flex flex-col sm:flex-row gap-4 pt-4">
                                          {/* 使用优化的LoadingButton */}
                    <LoadingButton
                      isLoading={loading}
                      loadingText="正在生成..."
                      normalText={isInspirationMode ? (isPlusMode ? '创意组合' : '生成灵感') : '开始AI写作'}
                      onClick={handleSubmit}
                      variant="primary"
                      className="flex-1"
                    />
                      
                      <Button
                        type="button"
                        variant="outline"
                        onClick={handleClear}
                        disabled={loading}
                      >
                        清空表单
                      </Button>
                      
                      {!isInspirationMode && (
                        <Button
                          type="button"
                          variant="outline"
                          onClick={saveSettings}
                          disabled={loading}
                          className="flex items-center"
                        >
                          <Settings className="w-4 h-4 mr-2" />
                          保存设置
                        </Button>
                      )}
                    </div>
                  </form>
                </CardContent>
              </Card>
            </div>
            
            {/* 右侧：结果显示 */}
            <div>
              <Card className="h-full">
                <CardHeader>
                  <CardTitle className="flex items-center justify-between">
                    <span>生成结果</span>
                    {result && (
                      <div className="flex items-center space-x-2">
                        <span className="text-sm text-gray-500">
                          {wordCount} 字
                        </span>
                      </div>
                    )}
                  </CardTitle>
                  <CardDescription>
                    {result 
                      ? (isInspirationMode ? '生成的灵感点子如下' : 'AI生成的写作内容如下')
                      : (isInspirationMode ? '填写左侧表单并点击"生成灵感"' : '填写左侧表单并点击"开始AI写作"')
                    }
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  {result ? (
                    <div className="space-y-4">
                      <div className="prose max-w-none">
                        <div className="whitespace-pre-wrap text-gray-800">
                          {result}
                        </div>
                      </div>
                      {renderActionButtons()}
                    </div>
                  ) : (
                    <div className="flex flex-col items-center justify-center py-12 text-center">
                      <div className="w-16 h-16 bg-gradient-to-r from-blue-100 to-purple-100 rounded-full flex items-center justify-center mb-4">
                        {isInspirationMode ? (
                          <Lightbulb className="w-8 h-8 text-purple-600" />
                        ) : (
                          <Brain className="w-8 h-8 text-blue-600" />
                        )}
                      </div>
                      <h3 className="text-lg font-medium text-gray-900 mb-2">
                        {isInspirationMode ? '等待生成创意灵感' : '等待生成写作内容'}
                      </h3>
                      <p className="text-gray-500 max-w-md">
                        {isInspirationMode
                          ? '填写左侧的灵感设置，然后点击"生成灵感"按钮，AI将为你生成创意写作点子。'
                          : '填写左侧的写作表单，然后点击"开始AI写作"按钮，AI将为你生成独特的写作内容。'
                        }
                      </p>
                    </div>
                  )}
                </CardContent>
              </Card>
            </div>
          </div>
        </div>
      </main>
    </div>
  )
}